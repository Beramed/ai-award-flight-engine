; Engine configuration file.
; Kiko: Wild Fury - Matajava
config_version=5

[application]
config/name="Kiko: Wild Fury - Matajava"
config/description="Run and Gun 16-bit inspirado em Metal Slug / Contra"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.svg"

[autoload]
Roteiro="*res://scripts/roteiro.gd"
GameState="*res://scripts/game_state.gd"
SpriteLib="*res://scripts/sprite_library.gd"
ArcadeFX="*res://scripts/arcade_fx.gd"

[display]
window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/vsync/vsync_mode=1

[layer_names]
2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="enemies"
2d_physics/layer_4="player_shots"
2d_physics/layer_5="enemy_shots"
2d_physics/layer_6="pickups"
2d_physics/layer_7="player_hurt"
2d_physics/layer_8="enemy_hurt"

[rendering]
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.043, 0.063, 0.125, 1)

[physics]
common/physics_ticks_per_second=60

[input]
